*.raw
*.log
__pycache__/
.DS_Store

# Raw per-corner ngspice logs under sim/<experiment>/corners/<record-id>/ are
# the evidence trail sim/README.md requires each record to link to -- they are
# committed, not scratch, so they are exempted from the blanket *.log ignore.
!sim/*/corners/**/*.log

# Same exemption for the raw ngspice logs of the small committed control
# experiments under sim/<experiment>/control/ (e.g. the gmin control in
# sim/bias-core-startup/control/): they are the evidence the surrounding
# document's numbers are transcribed from, not scratch.
!sim/*/control/logs/*.log

# Simulation harness scratch: generated ngspice decks. Disposable; the
# evidence that is meant to survive lives in sim/<experiment-slug>/.
sim/.work/

# Full v(t) traces a control experiment's wrdata step writes (e.g.
# sim/por-glitch/control/, sim/por-ramp-rate/control/): large, regenerable on
# demand from the committed decks/ + logs/, and no design document or
# results.md cites them directly (only the numbers results.md derives from
# them) -- so, unlike control/logs/*.log, they are not the evidence itself.
sim/*/control/traces/

# Machine-local PDK override (sim/pdk.json is the committed default).
sim/pdk.local.json
