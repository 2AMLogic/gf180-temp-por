.ends bias_core

.control
set numdgt=10
set noaskquit
  tran 20.0u 120.0m
  meas tran vref_st find v(vrefst) at=119.9m
  meas tran vref_end find v(vrefb) at=119.9m
  meas tran t_recover when v(eb)=0.012 fall=last
  meas tran t_ok_last when v(bias_okb)=1.4 rise=last
  meas tran t_false integ v(fob) from=0 to=120.0m
  let m_vref_st = vref_st
  let m_vref_end = vref_end
  let m_t_recover = t_recover
  let m_t_ok_last = t_ok_last
  let m_t_false = t_false
  print m_vref_st
  print m_vref_end
  print m_t_recover
  print m_t_ok_last
  print m_t_false
.endc
.end
