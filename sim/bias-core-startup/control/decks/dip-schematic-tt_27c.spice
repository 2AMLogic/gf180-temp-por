  meas tran vr450 find v(vrefb) at=45.0m
  meas tran ok500 find v(bias_okb) at=50.0m
  meas tran vr500 find v(vrefb) at=50.0m
  let m_ok335 = ok335
  let m_vr335 = vr335
  let m_ok340 = ok340
  let m_vr340 = vr340
  let m_ok350 = ok350
  let m_vr350 = vr350
  let m_ok360 = ok360
  let m_vr360 = vr360
  let m_ok380 = ok380
  let m_vr380 = vr380
  let m_ok400 = ok400
  let m_vr400 = vr400
  let m_ok450 = ok450
  let m_vr450 = vr450
  let m_ok500 = ok500
  let m_vr500 = vr500
  print m_ok335
  print m_vr335
  print m_ok340
  print m_vr340
  print m_ok350
  print m_vr350
  print m_ok360
  print m_vr360
  print m_ok380
  print m_vr380
  print m_ok400
  print m_vr400
  print m_ok450
  print m_vr450
