set numdgt=10
set noaskquit
  tran 20.0u 52.0m
  meas tran ok335 find v(bias_okb) at=33.5m
  meas tran vr335 find v(vrefb) at=33.5m
  meas tran ok340 find v(bias_okb) at=34.0m
  meas tran vr340 find v(vrefb) at=34.0m
